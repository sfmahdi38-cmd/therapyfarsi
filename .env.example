# Copy this file to .env.local and fill in the values. .env.local is never committed to git.

# Daily — dashboard.daily.co → Developers → API key
DAILY_API_KEY=
DAILY_DOMAIN=thropy.daily.co

# LiveKit Cloud — cloud.livekit.io → project tropifarsi → Settings → API keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
